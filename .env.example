
# Die folgenden Variablen werden automatisch von Vercel/Upstash gesetzt,
# sobald ihr in eurem Vercel-Projekt eine Upstash-Redis-Datenbank und einen Blob-Store verbindet.
# Ihr muesst sie NICHT manuell eintragen.
#
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...
# BLOB_READ_WRITE_TOKEN=...
#
# CRON_SECRET wird automatisch von Vercel gesetzt, sobald ihr crons in
# vercel.json habt (bereits im Projekt enthalten) - auch hier nichts zu tun.
# CRON_SECRET=...
